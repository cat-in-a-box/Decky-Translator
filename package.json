{
  "name": "decky-language-tutor",
  "version": "0.1.0",
  "type": "module",
  "description": "Study English and translate game text on Steam Deck",
  "scripts": {
    "build": "shx rm -rf dist && rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "package": "bash scripts/package-plugin.sh"
  },
  "keywords": [
    "decky",
    "plugin",
    "translation",
    "language-learning",
    "steam-deck",
    "deck"
  ],
  "author": "Decky Language Tutor contributors",
  "license": "GNU GPLv3",
  "devDependencies": {
    "@decky/api": "^1.1.3",
    "@decky/rollup": "^1.0.1",
    "@decky/ui": "^4.11.1",
    "@types/react": "16.14.0",
    "@types/react-dom": "^19.1.2",
    "@types/webpack": "^5.28.0",
    "rollup": "^4.24.0",
    "shx": "^0.3.4",
    "tslib": "^2.4.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "qrcode.react": "^4.2.0",
    "react-icons": "^4.4.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
